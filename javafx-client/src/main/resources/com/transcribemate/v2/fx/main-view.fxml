<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- 
This FXML file defines the main view of the TranscribeMate application. 
It uses a BorderPane as the root layout, with a top section containing the header and action buttons, and a center section containing the workspace with multiple panes for dashboard, projects, files, and modules. 
The view is styled using CSS classes and includes various controls such as labels, buttons, tables, and input fields to interact with the application's features. 
The controller for this view is specified as MainController, which will handle the user interactions defined in this FXML. 
-->

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.transcribemate.v2.fx.MainController">
  <styleClass>
    <String fx:value="app-shell"/>
    <String fx:value="theme-light"/>
  </styleClass>
  <!-- Top section with header, status, and action buttons -->
  <top>
    <VBox spacing="20.0" styleClass="app-header-shell">
      <padding>
        <Insets top="12.0" right="16.0" bottom="10.0" left="16.0"/>
      </padding>

      <!-- Title bar with app name, status, step and system monitor button -->
      <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="app-titlebar card-pane">
        <children>
          <VBox spacing="2.0">
            <children>
              <Label fx:id="appTitleLabel" text="TranscribeMate" styleClass="title"/>
              <Label text="by NEBEHAY Martin" styleClass="app-credit"/>
              <Label text="V2 Studio - transcription, translation, subtitle and speaker workflows" styleClass="subtitle"/>
            </children>
          </VBox>
          <Region HBox.hgrow="ALWAYS"/>
          <Label text="Status" styleClass="small-label" visible="false" managed="false"/>
          <Label fx:id="statusLabel" text="Ready" styleClass="status-value" visible="false" managed="false"/>
          <Separator orientation="VERTICAL" prefHeight="20.0" visible="false" managed="false"/>
          <Label text="Step" styleClass="small-label" visible="false" managed="false"/>
          <Label fx:id="stepLabel" text="-" styleClass="status-value" visible="false" managed="false"/>
          <Button text="App settings" onAction="#onOpenAppSettings"/>
          <Button fx:id="monitorButton" text="System monitor" onAction="#onOpenMonitor" styleClass="accent-btn"/>
        </children>
      </HBox>

      <!-- Status strip with progress, ETA, simple mode toggle and preflight toggle -->
      <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="status-strip card-pane" visible="false" managed="false">
        <children>
          <Label text="Progress" styleClass="small-label"/>
          <ProgressBar fx:id="progressBar" HBox.hgrow="ALWAYS"/>
          <Separator orientation="VERTICAL" prefHeight="20.0"/>
          <Label text="Remaining" styleClass="small-label"/>
          <Label fx:id="etaLabel" text="--:--" styleClass="eta-value"/>
          <Separator orientation="VERTICAL" prefHeight="20.0"/>
          <CheckBox fx:id="simpleModeBox" text="Simple mode" selected="true" onAction="#onToggleSimpleMode"/>
          <CheckBox fx:id="autoPreflightBox" text="Run preflight before Start" selected="true"/>
        </children>
      </HBox>

      <!-- Action row with main workflow buttons and utility actions -->
      <FlowPane hgap="8.0" vgap="6.0" alignment="CENTER_LEFT" styleClass="action-row card-pane" visible="false" managed="false">
        <children>
          <Button fx:id="startButton" text="Start" onAction="#onStart" styleClass="primary-btn"/>
          <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
          <Button fx:id="preflightButton" text="Preflight" onAction="#onRunPreflight"/>
          <Separator orientation="VERTICAL" prefHeight="20.0"/>
          <Button fx:id="refreshModelsButton" text="Refresh model cache" onAction="#onRefreshModels"/>
          <Button fx:id="installRuntimeButton" text="Repair runtime" onAction="#onRepairRuntime"/>
        </children>
      </FlowPane>

      <!-- Navigation row for switching between workspace panes -->
      <FlowPane hgap="8.0" vgap="6.0" alignment="CENTER_LEFT" styleClass="workspace-nav-row card-pane" visible="false" managed="false">
        <children>
          <Label text="Workspace" styleClass="small-label"/>
          <Button fx:id="navDashboardButton" text="Dashboard" onAction="#onNavDashboard" styleClass="button main-nav-btn"/>
          <Button fx:id="navProjectsButton" text="Projects" onAction="#onNavProjects" styleClass="button main-nav-btn"/>
          <Button fx:id="navFilesButton" text="Project Files" onAction="#onNavFiles" styleClass="button main-nav-btn"/>
          <Button fx:id="navModulesButton" text="Project Workflow" onAction="#onNavModules" styleClass="button main-nav-btn"/>
          <Button fx:id="navOperationsButton" text="Operations" onAction="#onNavOperations" styleClass="button main-nav-btn"/>
          <Button fx:id="navSettingsButton" text="Settings" onAction="#onNavSettings" styleClass="button main-nav-btn"/>
        </children>
      </FlowPane>
    </VBox>
  </top>

  <!-- Center section with workspace panes -->
  <center>
    <HBox spacing="12.0" styleClass="workspace-shell">
      <padding>
        <Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/>
      </padding>

      <!-- StackPane to hold different workspace panes (dashboard, projects, files, modules) -->
      <children>
        <StackPane fx:id="workspaceStack" HBox.hgrow="ALWAYS">
          <children>

            <!-- Dashboard pane with project overview, gallery and recent activity -->
            <VBox fx:id="dashboardPane" spacing="10.0" styleClass="workspace-pane">
              <children>
                <!-- Dashboard overview card with active project, stats and quick actions -->
                <VBox spacing="10.0" styleClass="card-pane" visible="false" managed="false">
                  <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
                  <Label text="Project Dashboard" styleClass="section-title"/>
                  <Label fx:id="dashboardActiveProjectLabel" text="Active project: none" wrapText="true" styleClass="small-label"/>
                  <Label fx:id="dashboardProjectStatsLabel" text="Input: 0 | Output: 0 | Transcripts: 0 | Job snapshots: 0" wrapText="true" styleClass="small-label"/>
                  <HBox spacing="8.0">
                    <children>
                      <Button fx:id="dashboardRefreshButton" text="Refresh dashboard" onAction="#onRefreshDashboard" styleClass="accent-btn"/>
                      <Button fx:id="dashboardOpenProjectButton" text="Open project folder" onAction="#onDashboardOpenProjectFolder"/>
                      <Button fx:id="dashboardImportFilesButton" text="Import files" onAction="#onDashboardImportFiles"/>
                      <Button fx:id="dashboardOpenOutputFolderButton" text="Open output folder" onAction="#onDashboardOpenOutputFolder"/>
                      <Button fx:id="dashboardOpenWizardButton" text="Open wizard" onAction="#onDashboardOpenWizardForActive"/>
                    </children>
                  </HBox>
                </VBox>

                <!-- Projects gallery card showing project thumbnails and quick access -->
                <VBox spacing="8.0" styleClass="card-pane" VBox.vgrow="ALWAYS">
                  <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                      <Label text="Projects gallery" styleClass="section-title"/>
                      <Region HBox.hgrow="ALWAYS"/>
                    </children>
                  </HBox>
                  <Label fx:id="dashboardGalleryInfoLabel" text="No projects yet. Use the Create Project card to start." styleClass="small-label"/>
                  <ScrollPane fitToWidth="true" prefViewportHeight="500.0" styleClass="project-gallery-scroll"> <!-- Scrollable area for project thumbnails -->
                    <content>
                      <FlowPane fx:id="dashboardProjectGalleryBox" hgap="10.0" vgap="10.0"/>
                    </content>
                  </ScrollPane>
                </VBox>

                <!-- Recent activity card with recently edited files and timeline preview -->
                <HBox spacing="10.0" VBox.vgrow="ALWAYS" visible="false" managed="false">
                  <children>
                    <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                      <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                      <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <children>
                          <Label text="Recent project outputs" styleClass="section-title"/>
                          <Region HBox.hgrow="ALWAYS"/>
                          <Button fx:id="dashboardOpenSelectedRecentButton" text="Open selected" onAction="#onDashboardOpenSelectedRecentFile"/>
                        </children>
                      </HBox>
                      <TableView fx:id="dashboardRecentFilesTable" VBox.vgrow="ALWAYS">
                        <columns>
                          <TableColumn fx:id="dashboardRecentPathColumn" text="Path" prefWidth="410.0"/>
                          <TableColumn fx:id="dashboardRecentTypeColumn" text="Type" prefWidth="100.0"/>
                          <TableColumn fx:id="dashboardRecentModifiedColumn" text="Modified" prefWidth="170.0"/>
                        </columns>
                      </TableView>
                    </VBox>

                    <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                      <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                      <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <children>
                          <Label text="Project timeline" styleClass="section-title"/>
                          <Region HBox.hgrow="ALWAYS"/>
                          <Button fx:id="dashboardOpenTimelineButton" text="Open timeline file" onAction="#onDashboardOpenTimeline"/>
                        </children>
                      </HBox>
                      <Label fx:id="dashboardTimelineInfoLabel" text="Timeline: no data yet." styleClass="small-label"/>
                      <TextArea fx:id="dashboardTimelineArea" editable="false" wrapText="false" prefRowCount="16" VBox.vgrow="ALWAYS"/>
                    </VBox>
                  </children>
                </HBox>
              </children>
            </VBox>

            <VBox fx:id="projectsPane" spacing="10.0" styleClass="workspace-pane" visible="false" managed="false">
              <children>
                <VBox spacing="10.0" styleClass="card-pane" VBox.vgrow="ALWAYS">
                  <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
                  <Label text="Projects" styleClass="section-title"/>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                      <Button fx:id="projectCreateButton" text="Create project" onAction="#onCreateProject" styleClass="accent-btn"/>
                      <Button fx:id="projectSelectButton" text="Select project" onAction="#onSelectProject"/>
                      <Button fx:id="projectDeleteButton" text="Delete project" onAction="#onDeleteProject"/>
                      <Button fx:id="projectOpenFolderButton" text="Open folder" onAction="#onOpenProjectFolder"/>
                      <Button fx:id="projectRefreshButton" text="Refresh" onAction="#onRefreshProjects"/>
                    </children>
                  </HBox>
                  <Label fx:id="activeProjectLabel" text="Active project: none" styleClass="small-label"/>
                  <TableView fx:id="projectTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="projectNameColumn" text="Project" prefWidth="220.0"/>
                      <TableColumn fx:id="projectStatusColumn" text="Status" prefWidth="110.0"/>
                      <TableColumn fx:id="projectUpdatedColumn" text="Updated" prefWidth="170.0"/>
                      <TableColumn fx:id="projectSizeColumn" text="Size" prefWidth="120.0"/>
                      <TableColumn fx:id="projectPathColumn" text="Folder" prefWidth="380.0"/>
                    </columns>
                  </TableView>
                  <Label text="Each project has its own folder structure: input, output, jobs, logs, assets and temp." wrapText="true" styleClass="small-label"/>
                </VBox>
              </children>
            </VBox>

            <VBox fx:id="filesPane" spacing="10.0" styleClass="workspace-pane" visible="false" managed="false">
              <children>
                <VBox spacing="10.0" styleClass="card-pane" VBox.vgrow="ALWAYS">
                  <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
                  <Label text="Files" styleClass="section-title"/>
                  <Label fx:id="filesActiveProjectLabel" text="Project: none" styleClass="small-label"/>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                      <Button fx:id="filesImportButton" text="Import to input" onAction="#onImportFilesToProject" styleClass="accent-btn"/>
                      <Button fx:id="filesRefreshButton" text="Refresh" onAction="#onRefreshProjectFiles"/>
                      <Button fx:id="filesOpenSelectedButton" text="Open selected" onAction="#onOpenSelectedProjectFile"/>
                      <Button fx:id="filesAiSummaryButton" text="AI Summary..." onAction="#onFilesAiSummary"/>
                      <Button fx:id="filesOpenProjectFolderButton" text="Open project folder" onAction="#onOpenProjectFolder"/>
                      <Button fx:id="filesSaveEditorButton" text="Save editor" onAction="#onSaveProjectFileEditor"/>
                      <Button fx:id="filesHistoryButton" text="Open history" onAction="#onOpenEditedFileHistory"/>
                    </children>
                  </HBox>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                      <Label text="Search" styleClass="small-label"/>
                      <TextField fx:id="filesSearchField" promptText="filename, path, transcript content..." HBox.hgrow="ALWAYS"/>
                      <CheckBox fx:id="filesSearchContentBox" text="Search inside text files" selected="true"/>
                    </children>
                  </HBox>
                  <Label fx:id="filesDropHintLabel" text="Tip: drag and drop files/folders here to import into project input." styleClass="small-label"/>
                  <ScrollPane fitToWidth="true" prefViewportHeight="280.0" styleClass="project-gallery-scroll">
                    <content>
                      <VBox fx:id="filesGalleryHost" spacing="8.0">
                        <children>
                          <Label text="Input" styleClass="small-label"/>
                          <FlowPane fx:id="filesInputGalleryBox" hgap="10.0" vgap="10.0"/>
                          <Label text="Output" styleClass="small-label"/>
                          <FlowPane fx:id="filesOutputGalleryBox" hgap="10.0" vgap="10.0"/>
                        </children>
                      </VBox>
                    </content>
                  </ScrollPane>
                  <TableView fx:id="projectFilesTable" prefHeight="0.0" visible="false" managed="false">
                    <columns>
                      <TableColumn fx:id="projectFileRelativePathColumn" text="Path" prefWidth="520.0"/>
                      <TableColumn fx:id="projectFileTypeColumn" text="Type" prefWidth="90.0"/>
                      <TableColumn fx:id="projectFileSizeColumn" text="Size" prefWidth="120.0"/>
                      <TableColumn fx:id="projectFileModifiedColumn" text="Modified" prefWidth="170.0"/>
                    </columns>
                  </TableView>
                  <Label fx:id="fileEditorStatusLabel" text="Preview/editor: select a text file (.txt/.srt/.json/.md) from the gallery." styleClass="small-label"/>
                  <SplitPane dividerPositions="0.62" VBox.vgrow="ALWAYS">
                    <items>
                      <TextArea fx:id="projectFileEditorArea" prefRowCount="14" wrapText="false"/>
                      <TextArea fx:id="projectSidecarPreviewArea" prefRowCount="14" editable="false" wrapText="false" promptText="Related diarization / transcript sidecar preview"/>
                    </items>
                  </SplitPane>
                </VBox>
              </children>
            </VBox>

            <VBox fx:id="modulesPane" spacing="10.0" visible="false" managed="false">
              <children>
                <VBox fx:id="legacyModuleFlowCard" spacing="8.0" styleClass="card-pane">
                  <padding>
                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                  </padding>
                  <children>
                    <HBox fx:id="moduleSelectionRow" spacing="8.0" alignment="CENTER_LEFT">
                      <children>
                        <Label text="Project workflow workspace" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Active activity" styleClass="small-label"/>
                        <ComboBox fx:id="moduleSwitcherBox" prefWidth="260.0" onAction="#onModuleSwitcherChanged"/>
                        <Button fx:id="modulePreviousButton" text="Last used" onAction="#onModulePrevious"/>
                        <Button fx:id="settingsModuleButton" text="Settings tab" onAction="#onModuleSettings" styleClass="button"/>
                      </children>
                    </HBox>
                    <FlowPane fx:id="moduleQuickActionsPane" hgap="8.0" vgap="8.0">
                      <children>
                        <Button fx:id="runModuleButton" text="Offline A/V" onAction="#onModuleOffline" styleClass="button module-btn"/>
                        <Button fx:id="advancedModuleButton" text="YouTube Transcript" onAction="#onModuleYoutube" styleClass="button module-btn"/>
                        <Button fx:id="diarizationModuleButton" text="Speaker Transcript" onAction="#onModuleSpeaker" styleClass="button module-btn"/>
                        <Button fx:id="logsModuleButton" text="Conference Mode" onAction="#onModuleConference" styleClass="button module-btn"/>
                        <Button fx:id="jobsModuleButton" text="YouTube Subtitles" onAction="#onModuleYoutubeSubtitles" styleClass="button module-btn"/>
                        <Button fx:id="youtubeDubModuleButton" text="YouTube Dub" onAction="#onModuleYoutubeDub" styleClass="button module-btn"/>
                      </children>
                    </FlowPane>
                    <Label fx:id="moduleFlowTitleLabel" text="Activity: Offline A/V" styleClass="section-title"/>
                    <Label fx:id="moduleFlowLabel" text="1) Select local source.&#10;2) Configure model in Settings.&#10;3) Run Preflight and Start." wrapText="true" styleClass="small-label"/>
                    <Button fx:id="moduleFlowActionButton" text="Run Preflight" onAction="#onModuleFlowAction" styleClass="button accent-btn"/>
                  </children>
                </VBox>

                <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="module-tabs">
            <tabs>
              <Tab fx:id="runTab" text="Run">
                <ScrollPane fitToWidth="true" fitToHeight="true">
                  <content>
                    <VBox spacing="10.0" styleClass="scroll-content">
                      <padding>
                        <Insets top="6.0" right="6.0" bottom="6.0" left="6.0"/>
                      </padding>

                      <VBox fx:id="runWizardCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
                        <Label text="Guided project wizard" styleClass="section-title"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Button fx:id="wizardNextButton" text="Run wizard" onAction="#onRunProjectWizard" styleClass="accent-btn"/>
                          </children>
                        </HBox>
                        <Label fx:id="wizardStateLabel" text="Wizard guides activity selection, import, preflight and run in one assisted flow." styleClass="small-label" wrapText="true"/>
                      </VBox>

                      <VBox fx:id="runModuleContextCard" spacing="6.0" styleClass="card-pane">
                        <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
                        <Label text="Module context" styleClass="section-title"/>
                        <Label fx:id="runModuleContextLabel" text="Active module: Offline A/V Transcript. Values below are read-only and managed by wizard." wrapText="true" styleClass="small-label"/>
                      </VBox>

                      <VBox fx:id="runSourceCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Source" styleClass="section-title"/>
                        <GridPane hgap="10.0" vgap="8.0">
                          <columnConstraints>
                            <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120.0" prefWidth="160.0"/>
                          </columnConstraints>

                          <Label fx:id="sourceModeLabel" text="Source mode" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="sourceModeBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240.0"/>

                          <Label fx:id="localPathLabel" text="Local file/folder" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                          <TextField fx:id="localPathField" editable="false" promptText="C:\\path\\to\\file_or_folder" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                          <Button fx:id="localPathBrowseButton" text="Browse" onAction="#onBrowseLocalPath" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                          <Label fx:id="youtubeUrlLabel" text="YouTube URL" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                          <TextField fx:id="youtubeUrlField" editable="false" promptText="https://www.youtube.com/watch?v=..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                          <CheckBox fx:id="playlistBox" text="Playlist" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

                          <Label fx:id="qualityLabel" text="YouTube quality" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="qualityBox" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="220.0"/>
                        </GridPane>
                      </VBox>

                      <VBox fx:id="runOutputCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Output" styleClass="section-title"/>
                        <GridPane hgap="10.0" vgap="8.0">
                          <columnConstraints>
                            <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="120.0" prefWidth="170.0"/>
                          </columnConstraints>

                          <Label fx:id="outputDirLabel" text="Output directory" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                          <TextField fx:id="outputDirField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                          <Button fx:id="outputDirBrowseButton" text="Browse" onAction="#onBrowseOutputDir" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                          <Label fx:id="outputModeLabel" text="Output mode" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="outputModeBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="220.0"/>

                          <Label fx:id="outputPrefixLabel" text="Output prefix" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                          <TextField fx:id="outputPrefixField" editable="false" promptText="optional" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                          <CheckBox fx:id="keepOriginalsBox" text="Keep originals" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        </GridPane>
                      </VBox>

                      <VBox fx:id="runPreflightCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/></padding>
                        <Label text="Preflight checks and quick fixes" styleClass="section-title"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Label fx:id="preflightSummaryLabel" text="Preflight not executed yet." styleClass="small-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                          </children>
                        </HBox>
                        <TableView fx:id="preflightChecksTable" prefHeight="180.0">
                          <columns>
                            <TableColumn fx:id="preflightNameColumn" text="Check" prefWidth="170.0"/>
                            <TableColumn fx:id="preflightStatusColumn" text="Status" prefWidth="90.0"/>
                            <TableColumn fx:id="preflightMessageColumn" text="Message" prefWidth="520.0"/>
                            <TableColumn fx:id="preflightFixColumn" text="Suggested fix" prefWidth="200.0"/>
                          </columns>
                        </TableView>
                      </VBox>
                    </VBox>
                  </content>
                </ScrollPane>
              </Tab>

              <Tab fx:id="advancedTab" text="Advanced">
                <ScrollPane fitToWidth="true" fitToHeight="true">
                  <content>
                    <VBox spacing="10.0" styleClass="scroll-content">
                      <padding><Insets top="6.0" right="6.0" bottom="6.0" left="6.0"/></padding>

                      <VBox fx:id="advancedSubtitlesCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Subtitles" styleClass="section-title"/>
                        <GridPane hgap="10.0" vgap="8.0">
                          <columnConstraints>
                            <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                          </columnConstraints>

                          <Label text="Subtitle mode" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="subtitleModeBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220.0"/>

                          <Label text="Font" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                          <TextField fx:id="subtitleFontField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                          <Label text="Size" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                          <Spinner fx:id="subtitleSizeSpinner" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="120.0" editable="true"/>

                          <Label text="Colors" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                          <HBox spacing="8.0" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <children>
                              <Label text="Text" styleClass="small-label"/>
                              <ColorPicker fx:id="subtitleColorPicker"/>
                              <Label text="Outline" styleClass="small-label"/>
                              <ColorPicker fx:id="subtitleOutlineColorPicker"/>
                              <Label text="Width" styleClass="small-label"/>
                              <Spinner fx:id="subtitleOutlineWidthSpinner" prefWidth="90.0" editable="true"/>
                            </children>
                          </HBox>

                          <Label text="Translation" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                          <CheckBox fx:id="translateSubtitlesBox" text="Translate subtitles before embedding" selected="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>
                      </VBox>

                      <VBox fx:id="advancedConferenceCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Conference metadata" styleClass="section-title"/>
                        <GridPane hgap="10.0" vgap="8.0">
                          <columnConstraints>
                            <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                          </columnConstraints>

                          <Label text="Conference title" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                          <TextField fx:id="conferenceTitleField" promptText="Conference title" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                          <Label text="Conference date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                          <TextField fx:id="conferenceDateField" promptText="YYYY-MM-DD" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                          <Label text="Default speaker" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                          <TextField fx:id="speakerField" promptText="Speaker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                          <Label text="Default topic" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                          <TextField fx:id="topicField" promptText="Topic / session" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Button text="Add file row" onAction="#onAddConferenceFile"/>
                            <Button text="Remove row" onAction="#onRemoveConferenceFile"/>
                            <Button text="Sync from source" onAction="#onSyncConferenceFiles"/>
                          </children>
                        </HBox>

                        <TableView fx:id="conferenceFilesTable" editable="true" prefHeight="220.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="conferenceFilePathColumn" text="File" prefWidth="260.0"/>
                            <TableColumn fx:id="conferenceSpeakerColumn" text="Speaker" prefWidth="140.0"/>
                            <TableColumn fx:id="conferenceDescriptionColumn" text="Description" prefWidth="220.0"/>
                            <TableColumn fx:id="conferenceDateColumn" text="Date" prefWidth="120.0"/>
                          </columns>
                        </TableView>

                        <Label text="Conference mode uses this table to assign per-file metadata into transcript metadata." wrapText="true" styleClass="small-label"/>
                      </VBox>
                    </VBox>
                  </content>
                </ScrollPane>
              </Tab>

              <Tab fx:id="diarizationTab" text="Diarization">
                <VBox spacing="10.0" styleClass="card-pane">
                  <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>

                  <GridPane hgap="10.0" vgap="8.0">
                    <columnConstraints>
                      <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                      <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Enable diarization" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="diarizationEnabledBox" text="Enabled" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Backend" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="diarizationBackendBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="220.0"/>

                    <Label text="Accuracy profile" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="diarizationAccuracyBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="220.0"/>

                    <Label text="Min / max speakers" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <HBox spacing="8.0" GridPane.rowIndex="3" GridPane.columnIndex="1">
                      <children>
                        <Spinner fx:id="diarizationMinSpinner" prefWidth="100.0" editable="true"/>
                        <Spinner fx:id="diarizationMaxSpinner" prefWidth="100.0" editable="true"/>
                      </children>
                    </HBox>

                    <Label text="Options" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <VBox spacing="6.0" GridPane.rowIndex="4" GridPane.columnIndex="1">
                      <children>
                        <CheckBox fx:id="diarizationReviewBox" text="Review after each file"/>
                        <CheckBox fx:id="diarizationIncludeUnmappedBox" text="Include unmapped SPEAKER labels"/>
                        <CheckBox fx:id="diarizationPrefixSrtBox" text="Prefix speakers in SRT"/>
                        <CheckBox fx:id="diarizationProfilePrefillBox" text="Prefill from profiles"/>
                      </children>
                    </VBox>

                    <Label text="Runtime" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label text="Local-only diarization (no external token required)." styleClass="small-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                  </GridPane>

                  <Separator/>
                  <Label text="Speaker profile mapping" styleClass="section-title"/>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                      <Button text="Add" onAction="#onAddSpeakerProfile"/>
                      <Button text="Remove" onAction="#onRemoveSpeakerProfile"/>
                      <Button text="Import" onAction="#onImportSpeakerProfiles"/>
                      <Button text="Export" onAction="#onExportSpeakerProfiles"/>
                      <Button text="Preview" onAction="#onPreviewSpeakerProfiles"/>
                      <Button fx:id="applySpeakerMappingButton" text="Apply to Last Output" onAction="#onApplySpeakerMappingToLastOutput" disable="true"/>
                    </children>
                  </HBox>

                  <TableView fx:id="speakerProfilesTable" editable="true" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="speakerLabelColumn" text="Label" prefWidth="220.0"/>
                      <TableColumn fx:id="speakerNameColumn" text="Name" prefWidth="300.0"/>
                    </columns>
                  </TableView>

                  <TextArea fx:id="profilePreviewArea" editable="false" prefRowCount="4" wrapText="true" promptText="Profile preview"/>
                </VBox>
              </Tab>

              <Tab fx:id="logsTab" text="Logs">
                <VBox spacing="8.0">
                  <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>

                  <VBox spacing="8.0" styleClass="card-pane" VBox.vgrow="ALWAYS">
                    <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                      <children>
                        <Label text="Search" styleClass="small-label"/>
                        <TextField fx:id="logSearchField" promptText="filter log text" HBox.hgrow="ALWAYS"/>
                        <Label text="Level" styleClass="small-label"/>
                        <ComboBox fx:id="logLevelFilterBox" prefWidth="130.0"/>
                        <CheckBox fx:id="showUserLogsBox" text="User" selected="true"/>
                        <CheckBox fx:id="showTechnicalLogsBox" text="Technical" selected="true"/>
                        <CheckBox fx:id="logsErrorsOnlyBox" text="Errors only"/>
                        <CheckBox fx:id="logsPauseAutoscrollBox" text="Pause autoscroll"/>
                        <CheckBox fx:id="logsLinkSelectedJobBox" text="Follow selected job" selected="true"/>
                        <Button text="Clear" onAction="#onClearLogs"/>
                      </children>
                    </HBox>
                    <Label fx:id="logsJobFilterLabel" text="Log scope: all jobs" styleClass="small-label"/>
                    <Label fx:id="logsStreamInfoLabel" text="Showing 0 entries." styleClass="small-label"/>
                    <TextArea fx:id="filteredLogArea" editable="false" wrapText="true" prefRowCount="14" VBox.vgrow="ALWAYS"/>
                  </VBox>

                  <HBox spacing="8.0" visible="false" managed="false">
                    <children>
                      <TextArea fx:id="userLogArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                      <TextArea fx:id="technicalLogArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                    </children>
                  </HBox>
                </VBox>
              </Tab>

              <Tab fx:id="jobsTab" text="Jobs">
                <VBox spacing="10.0">
                  <padding>
                    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                  </padding>

                  <VBox spacing="8.0" styleClass="card-pane">
                    <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                      <children>
                        <Label text="Run history" styleClass="section-title"/>
                        <Label text="Search" styleClass="small-label"/>
                        <TextField fx:id="jobsSearchField" promptText="job id, mode, source..." HBox.hgrow="ALWAYS"/>
                        <Label text="Status" styleClass="small-label"/>
                        <ComboBox fx:id="jobsStatusFilterBox" prefWidth="130.0"/>
                        <CheckBox fx:id="jobsActiveModuleOnlyBox" text="Active module only" selected="true"/>
                        <Button fx:id="refreshJobsButton" text="Refresh" onAction="#onRefreshJobs"/>
                      </children>
                    </HBox>
                    <Label fx:id="jobsInfoLabel" text="Showing 0 jobs." styleClass="small-label"/>
                  </VBox>

                  <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                      <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <Label text="Jobs list" styleClass="section-title"/>
                        <TableView fx:id="jobHistoryTable" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="jobIdColumn" text="Job" prefWidth="150.0"/>
                            <TableColumn fx:id="jobStatusColumn" text="Status" prefWidth="110.0"/>
                            <TableColumn fx:id="jobModeColumn" text="Module" prefWidth="170.0"/>
                            <TableColumn fx:id="jobSourceColumn" text="Source" prefWidth="130.0"/>
                            <TableColumn fx:id="jobCreatedColumn" text="Created" prefWidth="160.0"/>
                          </columns>
                        </TableView>
                      </VBox>

                      <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Label text="Selected job details" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="replayJobButton" text="Replay selected" onAction="#onReplaySelectedJob"/>
                            <Button fx:id="removeJobButton" text="Remove" onAction="#onRemoveSelectedJob"/>
                          </children>
                        </HBox>
                        <TextArea fx:id="jobDetailArea" editable="false" wrapText="true" prefRowCount="14" VBox.vgrow="ALWAYS"/>
                      </VBox>
                    </children>
                  </HBox>
                </VBox>
              </Tab>

              <Tab fx:id="operationsTab" text="Operations">
                <VBox spacing="10.0">
                  <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>

                  <VBox spacing="8.0" styleClass="card-pane">
                    <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                      <children>
                        <Label text="Unified operations center" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Status" styleClass="small-label"/>
                        <Label fx:id="operationsStatusLabel" text="Ready" styleClass="status-value"/>
                        <Button fx:id="operationsRefreshDiagnosticsButton" text="Refresh diagnostics" onAction="#onRefreshOperationsDiagnostics"/>
                        <Button fx:id="operationsOpenMonitorButton" text="Open monitor" onAction="#onOpenMonitor"/>
                      </children>
                    </HBox>
                    <Label fx:id="operationsMetricsLabel" text="Diagnostics snapshot unavailable." styleClass="small-label" wrapText="true"/>
                  </VBox>

                  <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                      <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <Label text="Jobs queue" styleClass="section-title"/>
                        <TableView fx:id="operationsJobsTable" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="operationsJobIdColumn" text="Job" prefWidth="140.0"/>
                            <TableColumn fx:id="operationsJobStatusColumn" text="Status" prefWidth="100.0"/>
                            <TableColumn fx:id="operationsJobModeColumn" text="Module" prefWidth="160.0"/>
                            <TableColumn fx:id="operationsJobCreatedColumn" text="Created" prefWidth="150.0"/>
                          </columns>
                        </TableView>
                      </VBox>
                      <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <Label text="Live logs (filtered)" styleClass="section-title"/>
                        <TextArea fx:id="operationsLogsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                      </VBox>
                      <VBox spacing="8.0" styleClass="card-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>
                        <Label text="Diagnostics details" styleClass="section-title"/>
                        <TextArea fx:id="operationsDiagnosticsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                      </VBox>
                    </children>
                  </HBox>
                </VBox>
              </Tab>

              <Tab fx:id="settingsTab" text="Settings">
                <ScrollPane fitToWidth="true" fitToHeight="true">
                  <content>
                    <VBox spacing="10.0" styleClass="scroll-content">
                      <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
                      </padding>

                      <VBox spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Settings scope" styleClass="section-title"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Label text="Active module"/>
                            <ComboBox fx:id="settingsModuleBox" prefWidth="240.0" onAction="#onSettingsModuleChanged"/>
                            <Button fx:id="settingsLoadModuleButton" text="Load module state" onAction="#onLoadSettingsModule"/>
                            <Button fx:id="settingsResetModuleDefaultsButton" text="Reset defaults" onAction="#onResetSettingsModuleDefaults"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Search" styleClass="small-label"/>
                            <TextField fx:id="settingsSearchField" promptText="theme, runtime, model, language..." prefWidth="280.0"/>
                          </children>
                        </HBox>
                      </VBox>

                      <VBox fx:id="settingsAppearanceCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Global - Appearance" styleClass="section-title"/>
                        <GridPane hgap="10.0" vgap="8.0">
                          <columnConstraints>
                            <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                          </columnConstraints>
                          <Label text="UI language" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="uiLanguageBox" prefWidth="220.0" onAction="#onUiLanguageChanged" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                          <Label text="Theme" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="themeBox" prefWidth="220.0" onAction="#onThemeChanged" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>
                        <Label text="Theme and UI language are global app settings remembered for next app start." wrapText="true" styleClass="small-label"/>
                      </VBox>

                      <VBox fx:id="settingsRuntimeCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Global - Runtime &amp; Paths" styleClass="section-title"/>
                        <Label text="Use repair when runtime dependencies or models are broken. This re-runs online setup and may download several GB. Restart app after success." wrapText="true" styleClass="small-label"/>
                        <HBox spacing="8.0">
                          <children>
                            <Button fx:id="settingsRepairRuntimeButton" text="Repair runtime" onAction="#onRepairRuntime"/>
                            <Button text="Open app data" onAction="#onOpenData"/>
                            <Button text="Open output" onAction="#onOpenOutput"/>
                          </children>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Label text="Workspace root"/>
                            <TextField fx:id="settingsWorkspaceRootField" editable="false" prefWidth="520.0"/>
                            <Button fx:id="settingsChangeWorkspaceRootButton" text="Change..." onAction="#onChangeWorkspaceRoot"/>
                          </children>
                        </HBox>
                        <Label fx:id="settingsWorkspaceRootInfoLabel" text="Changing workspace root moves project folders to a new location." wrapText="true" styleClass="small-label"/>
                      </VBox>

                      <VBox fx:id="settingsCoreCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label fx:id="settingsScopeLabel" text="Module settings - active module" styleClass="section-title"/>
                        <HBox fx:id="settingsModuleScopeRow" spacing="8.0" alignment="CENTER_LEFT" visible="true" managed="true">
                          <children>
                            <Label text="Scope"/>
                            <Label fx:id="settingsScopeValueLabel" text="Global defaults" styleClass="small-label"/>
                            <Button fx:id="settingsResetProjectModuleButton" text="Reset project module from defaults" onAction="#onResetProjectModuleFromDefaults"/>
                            <Button fx:id="settingsSaveGlobalDefaultsButton" text="Save as global defaults" onAction="#onSaveModuleAsGlobalDefaults"/>
                          </children>
                        </HBox>
                        <HBox fx:id="settingsPresetRow" spacing="8.0" alignment="CENTER_LEFT">
                          <children>
                            <Label text="Preset"/>
                            <ComboBox fx:id="settingsPresetBox" prefWidth="220.0"/>
                            <Button fx:id="settingsSavePresetButton" text="Save" onAction="#onSaveModulePreset"/>
                            <Button fx:id="settingsLoadPresetButton" text="Load" onAction="#onLoadModulePreset"/>
                            <Button fx:id="settingsDeletePresetButton" text="Delete" onAction="#onDeleteModulePreset"/>
                          </children>
                        </HBox>
                        <GridPane hgap="10.0" vgap="8.0">
                          <columnConstraints>
                            <ColumnConstraints minWidth="170.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="180.0" prefWidth="260.0"/>
                          </columnConstraints>

                          <Label fx:id="settingsWhisperModelLabel" text="Whisper model" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="modelField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220.0"/>
                          <HBox fx:id="settingsModelOptionsBox" spacing="10.0" GridPane.rowIndex="0" GridPane.columnIndex="2">
                            <children>
                              <CheckBox fx:id="autoModelBox" text="Auto model"/>
                              <CheckBox fx:id="useGpuBox" text="Prefer GPU"/>
                            </children>
                          </HBox>

                          <Label fx:id="settingsSourceLangLabel" text="Speech language" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="sourceLangBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="220.0"/>

                          <Label fx:id="settingsSummaryLangLabel" text="Summary language" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="summaryLangBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="220.0"/>

                          <Label fx:id="settingsSummaryAiLabel" text="AI summary" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                          <CheckBox fx:id="summaryAiBox" text="Generate AI summary for transcript TXT outputs" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

                          <Label fx:id="settingsSummaryModelTierLabel" text="AI summary model tier" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="summaryModelTierBox" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="220.0"/>

                          <Label fx:id="settingsTargetLangLabel" text="Translation target" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                          <ComboBox fx:id="targetLangBox" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="220.0"/>

                          <Label fx:id="settingsBatchSizeLabel" text="Batch size" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                          <Spinner fx:id="batchSizeSpinner" GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="120.0" editable="true"/>

                          <Label fx:id="settingsTextOptionsLabel" text="Text options" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                          <HBox fx:id="settingsTextOptionsBox" spacing="10.0" GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.columnSpan="2">
                            <children>
                              <CheckBox fx:id="cleanTextBox" text="Clean text"/>
                              <CheckBox fx:id="exportMdBox" text="Markdown"/>
                              <CheckBox fx:id="summaryPackBox" text="Summary pack"/>
                              <CheckBox fx:id="notifyDoneBox" text="Open output when done"/>
                            </children>
                          </HBox>

                          <Label fx:id="settingsSplitMinutesLabel" text="Split minutes" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                          <Spinner fx:id="splitMinutesSpinner" GridPane.rowIndex="8" GridPane.columnIndex="1" prefWidth="120.0" editable="true"/>
                        </GridPane>
                        <Label fx:id="settingsSpeakerModuleHintLabel" text="Speaker Transcript uses diarization settings in the Diarization tab. Unrelated options are hidden here." wrapText="true" styleClass="small-label" managed="false" visible="false"/>
                      </VBox>

                      <VBox fx:id="settingsModuleFlowCard" spacing="8.0" styleClass="card-pane">
                        <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>
                        <Label text="Module flow" styleClass="section-title"/>
                        <Label text="Offline A/V, YouTube transcript, Speaker transcript, Conference mode, YouTube subtitles and YouTube dub are separate modules with independent saved settings." wrapText="true" styleClass="small-label"/>
                      </VBox>
                    </VBox>
                  </content>
                </ScrollPane>
              </Tab>
            </tabs>
          </TabPane>
              </children>
            </VBox>
          </children>
        </StackPane>
      </children>
    </HBox>
  </center>
</BorderPane>
