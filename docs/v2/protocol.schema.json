{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribemate.local/schemas/v2/protocol.schema.json",
  "title": "TranscribeMate V2 IPC",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["type", "id", "method"],
      "properties": {
        "type": { "const": "request" },
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["type", "id", "ok", "ts"],
      "properties": {
        "type": { "const": "response" },
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "ts": { "type": "string" },
        "result": { "type": "object" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "details": {}
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } } },
          "then": { "required": ["result"] },
          "else": { "required": ["error"] }
        }
      ],
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": ["type", "event", "payload", "ts"],
      "properties": {
        "type": { "const": "event" },
        "event": { "type": "string", "minLength": 1 },
        "job_id": { "type": "string" },
        "payload": { "type": "object" },
        "ts": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
